# Starts-Agents environment — copy what you need into your service
# manager / ecosystem file. NEVER commit a filled-in copy.

# --- basics ---
START_AGENTS_PORT=8797
START_AGENTS_HOST=127.0.0.1
# START_AGENTS_DATA=/root/starts-agents/data

# --- cost gates (v0.14 batch 2) ---
# Every ceiling has a sane default; token caps take 0 = off.
# SA_BODY_LIMIT=1048576          JSON body cap in bytes (chat keeps a larger attachment cap)
# SA_CHAT_CONTENT_MAX=32000      max characters in one chat message
# SA_MAX_TOKENS_OUT=8192         max_tokens sent to API engines (0 = omit)
# SA_DAILY_TOKEN_CAP=20000000    per-user daily token hard cap (owners exempt)
# SA_RUN_TOKEN_BUDGET=2000000    per-run token budget, shared across delegation
# SA_RUN_WALL_MS=900000          per-run wall clock (15 min, approval waits included)
# SA_CONTEXT_TOKEN_BUDGET=120000 history window budget (character-estimated)
# SA_DISCONNECT_GRACE_MS=60000   abort a run this long after its client vanishes
# SA_BACKUP_KEEP=7               app.db snapshots retained in data/backups/
# SA_AUDIT_KEEP_DAYS=90          audit_log rows older than this are pruned at startup
# Rate limits: SA_RL_<NAME> hits per window; window override SA_RL_<NAME>_WINDOW_MS.
# SA_RL_SENDCODE_IP=10           per 10 min; over the limit no mail is sent, answer unchanged
# SA_RL_SENDCODE_GLOBAL=200      per hour
# SA_RL_SSO_EXCHANGE=30          per minute per IP
# SA_RL_CHAT_USER=20             per minute per user
# SA_RL_LOGIN_IP=30              per minute per IP (alongside the failure lockout)

# --- sandbox (v0.13) ---
# Where owner-installed optional modules (Chromium, Python venv,
# ffmpeg, pandoc, ripgrep+jq) live. Default: <app>/sandbox-modules.
# SANDBOX_MODULES_DIR=/root/starts-agents/sandbox-modules
# Per-bot workspace quota in MB for the write tools (default 500,
# 0 = unlimited):
# START_AGENTS_WORKSPACE_QUOTA_MB=500

# --- access ---
# Legacy access token (migration fallback). Once accounts exist it is
# only a fallback; setup requires it when set. Pure ASCII.
# START_AGENTS_ACCESS_TOKEN=
# Pin the Host header (comma-separated) behind proxies:
# START_AGENTS_ALLOWED_HOSTS=ai.example.com
# Trust X-Forwarded-For from your reverse proxy (rate limiting):
# TRUST_PROXY=1

# --- model fallback (bots WITHOUT their own provider only) ---
# START_AGENTS_AI_BASE_URL=https://api.openai.com/v1
# START_AGENTS_AI_API_KEY=
# START_AGENTS_AI_MODEL=gpt-4o-mini
# START_AGENTS_ENGINE=echo

# --- vault ---
# Master key for provider-key encryption (base64 32 bytes, or any
# passphrase — it is hashed). Without it, a key file is kept at
# ~/.starts-agents/vault.key. Back this up or lose every stored key.
# START_AGENTS_MASTER_KEY=
# START_AGENTS_VAULT_KEY_FILE=/home/you/.starts-agents/vault.key
# START_AGENTS_SHARE_SECRET_FILE=/home/you/.starts-agents/share-secret

# --- mail (password-reset codes) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=starttls
# …or, for self-host testing without a mail account:
# MAIL_TRANSPORT=log
# WARNING: never enable MAIL_TRANSPORT=log in production — password
# reset / verification codes are printed to the server log in plaintext.

# Public self-registration: open by default (new accounts are members
# and must prove an email with a mailed code). Set to 0 to close it.
# START_AGENTS_ALLOW_REGISTER=1

# Human verification — Cloudflare Turnstile (the same provider the
# main site uses). Both keys set -> widget + server check on login,
# registration and code sending. Unset -> no verification.
# START_AGENTS_TURNSTILE_SITE_KEY=
# START_AGENTS_TURNSTILE_SECRET=

# Social sign-in (each appears only when fully configured).
# Google: OAuth client from Google Cloud Console; the authorized
# redirect URI is https://<your-host>/api/auth/google/callback
# START_AGENTS_GOOGLE_CLIENT_ID=
# START_AGENTS_GOOGLE_CLIENT_SECRET=
# Telegram: a bot from @BotFather; set the bot's domain to this host
# with /setdomain. The token verifies widget signatures.
# START_AGENTS_TG_BOT_USERNAME=
# START_AGENTS_TG_BOT_TOKEN=
# Canonical origin for OAuth callbacks (behind proxies). Derived
# from the request Host when unset.
# START_AGENTS_PUBLIC_URL=

# Mail — the main site's setup (Resend): verification codes are sent
# from the same address as the main site.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=<your Resend API key>
# SMTP_FROM=Bot Work <secret@egame.dev>
